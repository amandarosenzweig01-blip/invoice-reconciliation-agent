<!DOCTYPE html><html><head><meta charset="utf-8"><style>
@page { size: Letter; margin: 0.75in; }
body { font-family: Helvetica, Arial, sans-serif; font-size: 10.5pt; color: #1a1a1a; }
.hdr { border-bottom: 3px solid #1a1a1a; padding-bottom: 10pt; margin-bottom: 20pt; }
.hdr h1 { font-size: 16pt; margin: 0; letter-spacing: -0.01em; }
.hdr .id { font-size: 9pt; color: #666; margin-top: 3pt; }
table.terms { width: 100%; border-collapse: collapse; margin-bottom: 20pt; }
table.terms td { padding: 7pt 0; border-bottom: 1px solid #e3e3e3; vertical-align: top; }
table.terms td.k { width: 36%; color: #666; font-size: 9.5pt; text-transform: uppercase; letter-spacing: 0.04em; }
table.terms td.v { font-weight: 600; }
table.del { width: 100%; border-collapse: collapse; font-size: 10pt; }
table.del th { text-align: left; background: #f2f2f2; padding: 6pt 8pt; font-size: 9pt; text-transform: uppercase; }
table.del td { padding: 6pt 8pt; border-bottom: 1px solid #eee; }
.note { margin-top: 22pt; font-size: 9pt; color: #555; line-height: 1.5; }
</style></head><body>
<div class="hdr"><h1>Partnership Terms</h1><div class="id">{{ contract.contract_id }} &middot; Medicube US, Inc.</div></div>
<table class="terms">
<tr><td class="k">Creator</td><td class="v">{{ contract.creator_name }}</td></tr>
<tr><td class="k">Total Fee</td><td class="v">{% if render.rate_in_words %}{{ contract.rate_usd|in_words }}{% else %}{{ contract.rate_usd|money }}{% endif %}</td></tr>
<tr><td class="k">Usage Window</td><td class="v">{{ contract.usage_window_start|pretty_date }} &ndash; {{ contract.usage_window_end|pretty_date }}</td></tr>
<tr><td class="k">Payment Terms</td><td class="v">Net {{ contract.payment_terms_days }}</td></tr>
</table>
<table class="del"><thead><tr><th>Deliverable</th><th>Qty</th></tr></thead><tbody>
{% for d in contract.deliverables %}
<tr><td>{{ d.type|replace("_", " ")|title }}</td><td>{{ d.count }}</td></tr>
{% endfor %}
</tbody></table>
<div class="note">Invoices referencing this agreement must cite {{ contract.contract_id }} and be submitted within {{ contract.payment_terms_days }} days of the close of the Usage Window.</div>
</body></html>
